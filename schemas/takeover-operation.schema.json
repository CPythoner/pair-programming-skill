{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CPythoner/pair-programming-skill/schemas/takeover-operation.schema.json",
  "title": "Pair Programming Takeover Operation",
  "type": "object",
  "required": [
    "schema_version",
    "operation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status",
        "scope",
        "strategy",
        "source",
        "checkpoint",
        "preflight",
        "apply",
        "validation",
        "recovery",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "takeover"
        },
        "status": {
          "type": "string",
          "enum": [
            "prepared",
            "applying",
            "applied",
            "validating",
            "completed",
            "interrupted",
            "needs_reconciliation",
            "abandoned"
          ]
        },
        "scope": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "step",
                "file",
                "symbol",
                "tests",
                "build",
                "dependencies",
                "tooling",
                "remaining",
                "all"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        "strategy": {
          "type": "string",
          "enum": [
            "",
            "semantic_port",
            "cherry_pick",
            "three_way_patch",
            "manual_adaptation"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": true
        },
        "checkpoint": {
          "type": "object",
          "required": [
            "path",
            "branch",
            "head",
            "status_porcelain",
            "staged_diff_path",
            "unstaged_diff_path",
            "untracked_files"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "head": {
              "type": "string"
            },
            "status_porcelain": {
              "type": "string"
            },
            "staged_diff_path": {
              "type": "string"
            },
            "unstaged_diff_path": {
              "type": "string"
            },
            "untracked_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": true
        },
        "apply": {
          "type": "object",
          "additionalProperties": true
        },
        "validation": {
          "type": "object",
          "required": [
            "status",
            "commands",
            "results"
          ],
          "additionalProperties": true,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "passed",
                "failed",
                "limited"
              ]
            },
            "commands": {
              "type": "array"
            },
            "results": {
              "type": "array"
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
