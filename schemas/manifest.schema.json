{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CPythoner/pair-programming-skill/schemas/manifest.schema.json",
  "title": "Pair Programming Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "feature",
    "design",
    "repository",
    "shadow",
    "validation",
    "pitfalls",
    "guide_quality",
    "steps",
    "risks",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "goal",
        "non_goals",
        "acceptance_criteria",
        "assumptions",
        "constraints"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "non_goals": {
          "type": "array"
        },
        "acceptance_criteria": {
          "type": "array"
        },
        "assumptions": {
          "type": "array"
        },
        "constraints": {
          "type": "array"
        }
      }
    },
    "design": {
      "type": "object",
      "required": [
        "path",
        "source",
        "status",
        "revision",
        "approved_revision"
      ],
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "",
            "user_provided",
            "ai_generated"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "",
            "awaiting_approval",
            "approved"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "approved_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "root",
        "human_branch",
        "baseline_head"
      ],
      "additionalProperties": true
    },
    "shadow": {
      "type": "object",
      "required": [
        "generation",
        "solution_status",
        "guide_branch",
        "guide_head"
      ],
      "additionalProperties": true,
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "solution_status": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "failed",
            "limited"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "commands",
        "last_results"
      ],
      "additionalProperties": true
    },
    "pitfalls": {
      "type": "object",
      "required": [
        "path",
        "total",
        "unresolved",
        "feature_wide"
      ],
      "additionalProperties": true
    },
    "guide_quality": {
      "type": "object",
      "required": [
        "status",
        "warnings",
        "failures"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "warnings",
            "failed"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "type": "array"
          },
          "pitfall_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[0-9]{3,}$"
            }
          },
          "guide_commit": {
            "type": "string"
          },
          "file_count": {
            "type": "integer",
            "minimum": 0
          },
          "effective_diff_lines": {
            "type": "integer",
            "minimum": 0
          },
          "size_exception_reason": {
            "type": "string"
          },
          "quality": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "risks": {
      "type": "array"
    },
    "decisions": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
